# Copy to .env and adjust
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis (approval emails). If Redis is not running, the app falls back
# to sending the email synchronously, so the approval flow still works.
CELERY_BROKER_URL=redis://localhost:6379/0

# Email: console backend prints emails in the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AirBooking <no-reply@airbooking.local>
# For real SMTP set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Live flight status (optional). AirLabs is used if a key is set, otherwise OpenSky.
AIRLABS_API_KEY=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

FRONTEND_URL=http://localhost:5173
